# ==============================================================================
# adk-otel Configuration Template (.env.example)
# Copy this file to .env and set your preferences.
# NEVER commit your actual .env file or credentials to source control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Model Selection (ADK_MODEL)
# ------------------------------------------------------------------------------
# - Model names starting with 'gemini-' use Google ADK's native GenAI integration.
# - Other model names use the LiteLLM adapter.
#
# Examples:
#   ADK_MODEL=gemini-2.5-flash                     # Google GenAI (Native)
#   ADK_MODEL=github_copilot/gpt-4.1               # GitHub Copilot via LiteLLM
#   ADK_MODEL=ollama_chat/llama3.2                 # Local Ollama via LiteLLM
#   ADK_MODEL=openai/gpt-4o-mini                   # OpenAI via LiteLLM
#   ADK_MODEL=anthropic/claude-3-5-sonnet-20241022 # Anthropic via LiteLLM
#   ADK_MODEL=groq/llama-3.3-70b-versatile         # Groq via LiteLLM
ADK_MODEL=gemini-2.5-flash

# ------------------------------------------------------------------------------
# 2. LLM Provider Credentials & Endpoints
# ------------------------------------------------------------------------------

# --- Google Gemini (AI Studio) ---
# Required if ADK_MODEL starts with 'gemini-' and Vertex AI is false.
GOOGLE_API_KEY=

# --- Google Vertex AI (Enterprise / Cloud IAM) ---
# If true, uses Google Cloud Application Default Credentials (ADC) or service account.
GOOGLE_GENAI_USE_VERTEXAI=False
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1

# --- Local Ollama ---
# Default local endpoint for Ollama when using ADK_MODEL=ollama_chat/...
OLLAMA_API_BASE=http://127.0.0.1:11434

# --- OpenAI (Optional via LiteLLM) ---
OPENAI_API_KEY=

# --- Anthropic (Optional via LiteLLM) ---
ANTHROPIC_API_KEY=

# --- Groq (Optional via LiteLLM) ---
GROQ_API_KEY=

# --- GitHub Copilot (via LiteLLM) ---
# Authenticate interactively via: litellm --model github_copilot/gpt-4.1
# Tokens are cached locally in ~/.litellm/ and treated as sensitive credentials.

# ------------------------------------------------------------------------------
# 3. OpenTelemetry Local Pipeline Configuration
# ------------------------------------------------------------------------------
# Identifies the agent service in Jaeger, Collector, and Prometheus
OTEL_SERVICE_NAME=adk-greeter

# OpenTelemetry OTLP/HTTP loopback endpoint on port 4318 (Agent -> Collector)
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf

# Opt-in to GenAI semantic conventions
OTEL_SEMCONV_STABILITY_OPT_IN=gen_ai

# Security: keep raw prompt/response text out of spans; capture as events only
OTEL_INSTRUMENTATION_GENAI_CAPTURE_MESSAGE_CONTENT=events

# Short metric export interval in milliseconds for immediate local dashboard feedback
OTEL_METRIC_EXPORT_INTERVAL=5000

# Retained only for parity with ADK Agent Engine; does NOT send local data to Google Cloud
AGENT_ENGINE_TELEMETRY=false
