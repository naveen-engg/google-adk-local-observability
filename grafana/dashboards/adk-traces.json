          "global_query_id": "",
          "parser": "backend",
          "refId": "A",
          "root_selector": "result.resourceSpans",
          "source": "url",
          "type": "json",
          "url": "http://127.0.0.1:16686/api/v3/traces?query.serviceName=adk-greeter&query.startTimeMin=${__from:date:iso}&query.startTimeMax=${__to:date:iso}&query.limit=${limit}",
          "url_options": {
            "data": "",
            "method": "GET"
          },
          "computed_columns": [
            {
              "selector": "startTimeNs / 1000000",
              "text": "startTime",
              "type": "number"
            }
          ]
        }
      ],
