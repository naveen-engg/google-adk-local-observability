                "value": "auto"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "traceID"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Inspect Waterfall (${__value.text})",
                    "url": "/d/adk-traces?var-trace_id=${__value.text}&${__url_time_range}"
                  }
                ]
              }
            ]
          }
        ]
      },
